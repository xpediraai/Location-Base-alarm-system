rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // USER PROFILES
    // -------------------------------------------------------------
    match /users/{userId} {
      // User can only read and write their own profile document
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.email is string &&
        (request.resource.data.uid == userId || request.resource.data.id == userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // -----------------------------------------------------------
      // DESTINATION ALARMS (users/{userId}/destinationAlarms/{alarmId})
      // -----------------------------------------------------------
      match /destinationAlarms/{alarmId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.destinationName is string &&
          request.resource.data.destinationName.size() > 0 &&
          request.resource.data.latitude is number &&
          request.resource.data.longitude is number &&
          request.resource.data.radiusMeters is number &&
          request.resource.data.radiusMeters > 0;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // -----------------------------------------------------------
      // SAVED LOCATIONS (users/{userId}/saved_locations/{locId})
      // -----------------------------------------------------------
      match /saved_locations/{locationId} {
        allow read, write: if isOwner(userId);
      }

      // -----------------------------------------------------------
      // TRIP HISTORY (users/{userId}/history/{tripId})
      // -----------------------------------------------------------
      match /history/{tripId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
